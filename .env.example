# Get your key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# Figma MCP auth token — get this by running OAuth flow with Figma
# For first tests, you can use Claude Desktop's existing Figma connection instead.
FIGMA_MCP_AUTH_TOKEN=

# Optional: pin a Figma file to work in (paste the file key from a Figma URL)
# figma.com/design/<FILE_KEY>/...
FIGMA_FILE_KEY=

# Default model
CLAUDE_MODEL=claude-opus-4-7
